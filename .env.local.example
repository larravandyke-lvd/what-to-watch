# --- Server-only secrets (Vercel: Settings > Environment Variables, NOT exposed to browser) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
TMDB_API_KEY=your_tmdb_v3_api_key

# --- Firebase web config (safe to expose to the browser, prefixed NEXT_PUBLIC_) ---
NEXT_PUBLIC_FIREBASE_API_KEY=xxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxxxxxx
NEXT_PUBLIC_FIREBASE_APP_ID=xxxxxxxx
